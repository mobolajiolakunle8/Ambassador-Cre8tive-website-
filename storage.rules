rules_version = '2';

// Portfolio editing now saves public HTTPS image links in Firestore rather than uploading
// media to Cloud Storage. Preserve read-only access to the previous project-object path so
// any already-published Firebase Storage image links remain visible while no new uploads occur.
service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{userId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
