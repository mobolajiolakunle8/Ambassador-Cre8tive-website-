rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mobolajiolakunle8@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validProjectImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Publicly readable so published portfolio images can render for every visitor.
    // Writes stay limited to the verified administrator's own storage path.
    match /projects/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && request.auth.uid == userId && validProjectImage();
      allow delete: if isAdmin() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
