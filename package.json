{
  "name": "ambassador-cre8tive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ambassador Cre8tive Firebase Hosting, Firestore, Storage, and Authentication setup.",
  "scripts": {
    "build:vercel": "node scripts/build-vercel.mjs",
    "vercel-build": "npm run build:vercel",
    "firebase:login": "firebase login",
    "emulators": "firebase emulators:start --only auth,firestore,storage,hosting",
    "deploy": "firebase deploy --only hosting,firestore:rules,storage,database",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,storage,database"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.36.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "uuid": "^11.1.1"
  }
}
